# ElevenLabs credentials (Conversational AI)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Conversational AI agent that handles the call (created in ElevenLabs dashboard)
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxx

# Imported SIP-trunk phone number id (Phone Numbers -> select number)
ELEVENLABS_PHONE_NUMBER_ID=phnum_xxxxxxxxxxxxxxxxxxxx

# ElevenLabs API base URL (no trailing slash).
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Optional SIP tech prefix prepended to the dialed number.
# Leave empty to dial the plain number.
TECH_PREFIX=

# Local webhook server port (module 4)
WEBHOOK_PORT=3000

# ---- Retell (parallel provider — outbound via a Retell SIP trunk) ----------
# API key from the Retell dashboard (Settings -> API Keys)
RETELL_API_KEY=
# Retell API base (default is fine)
RETELL_BASE_URL=https://api.retellai.com
# Outbound agent id (create via `npm run retell:agent`, or from the dashboard)
RETELL_AGENT_ID=
# VoiceLink DID imported into Retell via SIP trunking, E.164 (the from_number)
RETELL_FROM_NUMBER=+919429391391
# Optional SIP tech prefix prepended to the dialed number (empty = plain)
RETELL_TECH_PREFIX=
